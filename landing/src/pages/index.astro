---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Marca from '../components/Marca.astro';
import Captura from '../components/Captura.astro';
import { appRoute, SITE_URL, CONTACTO, REDES, CIUDAD, waLink } from '../lib/site.js';
import tablero from '../assets/sistema/tablero.webp';
import tableroCelular from '../assets/sistema/tablero-celular.webp';
import mostrador from '../assets/sistema/mostrador.webp';
import socios from '../assets/sistema/socios.webp';
import caja from '../assets/sistema/caja.webp';
import retencionCelular from '../assets/sistema/retencion-celular.webp';
import adentro from '../assets/sistema/adentro.webp';
import reportes from '../assets/sistema/reportes.webp';
import resumen from '../assets/sistema/resumen.webp';
import { getPlanes, formatoPrecio } from '../lib/plans.js';

// ============================================
// LA PÁGINA PRINCIPAL (rehecha el 2026-09-23, el sistema al frente desde el 2026-10-22)
// ============================================
// La web es para conseguir gimnasios que usen el SISTEMA: primero lo muestra (capturas de
// verdad, no una maqueta), después lo cuenta por dentro y en un día entero.
//
// El 2026-10-22 se bajaron la demo del mostrador, la calculadora y la sección del molinete
// (con su página): lo interactivo distraía del sistema, y el molinete es un agregado que se
// ofrece al que lo pide. El plan con control de acceso sigue en precios.
//
// ⛔ REGLA: todo lo que dice esta página tiene que ser cierto HOY en el producto. Sin
// testimonios inventados, sin "+500 gimnasios", sin porcentajes de estudio. El repositorio y
// la página son públicos, y un dueño de gimnasio te lo verifica con una llamada.
// ============================================

// El precio lo trae el backend en build time. Ver src/lib/plans.js para el porqué.
const planes = await getPlanes();
// El plan base: lo usa el FAQ del precio.
const plan = planes[0];
const wa = waLink();

const hechos = [
  { n: '2', u: 'clicks', t: 'para cobrar una cuota. El vencimiento se corre solo.' },
  { n: '0', u: 'aparatos', t: 'para arrancar: el QR de la puerta usa el celular del socio.' },
  { n: '0 %', u: 'de comisión', t: 'sobre lo que cobrás. Pagás el plan y nada más.' },
  { n: 'Sin', u: 'internet', t: 'el mostrador sigue cobrando, registrando y cerrando la caja.' },
];

// El sistema por dentro: cada pantalla con lo que se ve en ESA captura. Si una captura se
// cambia, el texto de al lado se revisa contra la imagen nueva.
const pantallas = [
  {
    img: mostrador, rotulo: 'Recepción', clase: '',
    alt: 'El buscador de la recepción con tres socios encontrados: dos con los días que les quedan en verde y uno vencido en rojo',
    titulo: 'Escribís el nombre y sabés si puede pasar',
    texto: 'El socio aparece con los días que le quedan, en verde, o los que lleva vencido, en rojo. Enter y la entrada queda registrada. Y si entra alguien que debe, el aviso queda a la vista del que atiende.',
    items: [
      'Los socios también marcan la entrada con el QR de la puerta, desde su celular.',
      'Sin internet sigue andando: los socios están guardados en la computadora del mostrador.',
      'Cada cobro y cada entrada quedan firmados con el nombre de quien atiende.',
    ],
  },
  {
    img: socios, rotulo: 'Socios', clase: 'es-verde',
    alt: 'La lista de socios con su estado (al día, vencido o de baja), su arancel y los días que le quedan, con los botones de cobrar, editar y WhatsApp',
    titulo: 'Todo tu padrón, con el estado de cada uno',
    texto: 'Al día, vencido o de baja, con su arancel y los días que le quedan. Desde la misma fila le cobrás la cuota, editás su ficha o le escribís por WhatsApp.',
    items: [
      'Cobrás en dos clicks y el vencimiento se corre solo.',
      'Traés el Excel de tu sistema actual con Importar, y te llevás todo cuando quieras con Exportar.',
      'Lo que se borra va a la papelera: nada se pierde por un click de más.',
    ],
  },
  {
    img: caja, rotulo: 'Caja', clase: 'es-ambar',
    alt: 'El cierre de caja del día: total cobrado, efectivo, transferencia y Mercado Pago, y la lista de cobros a cerrar',
    titulo: 'La caja se cuenta sola',
    texto: 'El efectivo por un lado, la transferencia y Mercado Pago por el otro, más las ventas del mostrador. Al cerrar, la cuenta ya está hecha: vos decidís cuánto se retira.',
    items: [
      'El Excel del día para el contador, en un click.',
      'Cada cierre queda sellado. Si después se corrige un cobro, la diferencia queda a la vista.',
      'Nada se borra: lo anulado queda tachado y a la vista.',
    ],
  },
  {
    img: retencionCelular, rotulo: 'Retención', clase: 'es-rojo', tipo: 'celular',
    alt: 'La pantalla de retención en el celular: tasa de retención, socios que vencen esta semana y vencidos, con el botón de WhatsApp',
    titulo: 'A quién escribirle antes de que se vaya',
    texto: 'Quién vence esta semana y quién ya está vencido, con el botón de WhatsApp al lado. Lo mirás desde el celular, en tu casa, y le escribís al que se atrasó antes de que deje de venir.',
    items: [
      'La tasa de retención del gimnasio, calculada sola.',
      'El tablero, los socios y la caja también se miran desde el celular.',
    ],
  },
];

// Tres pantallas más, en chico: completan el recorrido sin alargar la página.
const masPantallas = [
  {
    img: adentro, titulo: 'Quién está adentro ahora',
    alt: 'La pantalla "En el gimnasio" con los socios que están entrenando y hace cuánto entraron',
    texto: 'Los que entraron y todavía no salieron, con la hora, y el registro de todo el día.',
  },
  {
    img: reportes, titulo: 'Reportes en Excel y PDF',
    alt: 'La pantalla de reportes: socios, ingresos, asistencia y resumen, cada uno en Excel o PDF',
    texto: 'Socios, ingresos, asistencia y un resumen del período, listos para bajar.',
  },
  {
    img: resumen, titulo: 'Todas tus sucursales juntas',
    alt: 'El resumen del dueño con la plata cobrada mes a mes en cada sucursal y el total',
    texto: 'Si tenés más de un local, la plata cobrada de cada uno, mes a mes, en una sola pantalla.',
  },
];

// Un día de gimnasio, de punta a punta. Cada hora es una función que existe hoy.
const dia = [
  {
    hora: '07:00', icono: 'monitor', titulo: 'Abrís y el sistema ya está listo',
    // `openAtLogin` viene apagado (electron/store.cjs): se prende en la configuración de la
    // terminal. Hasta el 2026-10-22 esto decía "arranca sola", como si fuera de fábrica.
    texto: 'La app de Windows abre con la sesión iniciada y ya actualizada. Y si querés, la configurás para que arranque sola con la computadora del mostrador. A esa hora nadie busca contraseñas.',
    chip: { clase: 'es-azul', texto: 'Listo para atender' },
  },
  {
    hora: '07:12', icono: 'qr', titulo: 'El primero entra con su celular',
    texto: 'Escanea el QR del cartel de la puerta y marca la entrada. Sin instalar nada, sin tarjeta y sin hacer fila.',
    chip: { clase: 'es-verde', texto: 'Entrada por QR' },
  },
  {
    hora: '09:40', icono: 'sonido', titulo: 'Llega uno con la cuota vencida',
    texto: 'Suena el aviso y la música del gimnasio baja sola para que se escuche. El mostrador ve cuánto debe, le cobra en dos clicks y el vencimiento se corre solo.',
    chip: { clase: 'es-rojo', texto: 'Vencida hace 4 días' }, alerta: 'es-rojo',
  },
  {
    hora: '18:40', icono: 'sinRed', titulo: 'Se corta internet en plena hora pico',
    texto: 'Nadie se entera. Se sigue cobrando, dando de alta y registrando entradas. Cuando vuelve la conexión, sube todo en orden y con la hora en que pasó de verdad.',
    chip: { clase: 'es-ambar', texto: 'Sin conexión · todo sigue' }, alerta: 'es-ambar',
  },
  {
    hora: '21:30', icono: 'caja', titulo: 'Se cierra la caja en un minuto',
    texto: 'El sistema ya sumó el efectivo, la transferencia y Mercado Pago, y descontó los gastos del cajón. El que cierra solo escribe cuánto se lleva.',
    chip: { clase: 'es-azul', texto: 'Queda para mañana' },
  },
  {
    hora: '21:31', icono: 'archivo', titulo: 'El Excel del contador, en un click',
    texto: 'Los cobros, los gastos y el cierre del día, con fórmulas que el contador puede revisar. Nada se borra: lo anulado queda tachado y a la vista.',
    chip: { clase: 'es-verde', texto: 'Caja del día.xlsx' },
  },
  {
    hora: '22:15', icono: 'casa', titulo: 'Vos, desde tu casa',
    texto: 'Mirás el tablero desde el celular: cuánto entró, quién vence esta semana y a quién escribirle por WhatsApp antes de que se vaya.',
    chip: { clase: 'es-ambar', texto: 'Vencen esta semana: 5' },
  },
];

const roles = [
  {
    quien: 'El que atiende',
    icono: 'puerta',
    items: [
      'Busca al socio por nombre o DNI y ve el cartel con sus días.',
      'Cobra en dos clicks: efectivo, transferencia, Mercado Pago o tarjeta.',
      'Entra con su PIN: cada cobro y cada entrada quedan firmados con su nombre.',
    ],
  },
  {
    quien: 'Vos, el dueño',
    icono: 'grafico',
    items: [
      'El mes contra el mismo tramo del mes pasado, sin abrir una planilla.',
      'Quién vence esta semana y quién dejó de venir, con el botón de WhatsApp al lado.',
      'Todas tus sucursales en un resumen, cada una con su caja.',
    ],
  },
  {
    quien: 'Tu contador',
    icono: 'archivo',
    items: [
      'Un solo número de ingresos: el del tablero es el de la caja y el del Excel.',
      'Cada cierre queda sellado. Si después se corrige un cobro, la diferencia aparece a la vista.',
      'El Excel del día o de cualquier período, con fechas y montos que se pueden sumar.',
    ],
  },
  {
    quien: 'Tus socios',
    icono: 'celular',
    items: [
      'Marcan la entrada con el QR desde su celular, sin bajar ninguna app.',
      'No hacen fila en el mostrador a la hora pico.',
      'Si deben la cuota, el aviso les sale en su propio celular, no delante de toda la sala.',
    ],
  },
];

const confianza = [
  {
    icono: 'importar', titulo: 'Traemos tus socios',
    texto: 'Nos pasás el Excel de tu sistema actual, o tu planilla, y los cargamos con sus vencimientos. Ya pasamos gimnasios de cientos de socios sin cargar uno a mano. Hasta el historial de caja se puede traer.',
  },
  {
    icono: 'candado', titulo: 'Tus datos son tuyos',
    texto: 'Los bajás a Excel cuando quieras. Y además del respaldo del proveedor, hacemos uno propio todos los días, probado restaurándolo de verdad.',
  },
  {
    icono: 'check', titulo: 'Sin atarte a nada',
    texto: 'Catorce días gratis sin poner la tarjeta. Sin permanencia: si te vas, te llevás tus datos. Y sin comisión sobre lo que cobrás.',
  },
  {
    icono: 'wa', titulo: 'Hablás con quien lo hizo',
    texto: `Veltronik se hace en ${CIUDAD}. Si escribís por WhatsApp te contesta una persona que conoce el sistema por dentro, no un bot.`,
  },
];

const faq = [
  {
    q: '¿Cuánto cuesta Veltronik?',
    a: `El plan Veltronik cuesta $${formatoPrecio(plan.price)} por mes, por sucursal, con socios ilimitados. Arrancás con 14 días gratis y no te pedimos tarjeta para probarlo.`,
  },
  {
    q: '¿Es difícil de usar?',
    a: 'No. La pantalla del mostrador es un buscador, el cartel del socio y un botón de cobrar: el que atiende la aprende en una tarde. Y no arrancás solo: importamos tus socios y te acompañamos por WhatsApp los primeros días.',
  },
  {
    q: '¿Sirve si mi gimnasio es chico?',
    a: 'Sí. El precio es el mismo con 40 socios que con 400, así que cuanto más chico el gimnasio, más barato le sale por socio. Y no hay nada que instalar para empezar: se usa desde el navegador.',
  },
  {
    q: '¿Necesito comprar algún aparato?',
    a: 'No. Veltronik funciona con la computadora que ya tenés, y el check-in por QR usa el celular del socio. Los molinetes y el reconocimiento facial son opcionales, para el gimnasio que quiere que la puerta se abra sola.',
  },
  {
    q: '¿Puedo pasar los datos de mi sistema actual?',
    a: 'Sí. Si tu sistema exporta a Excel, importamos la lista de socios y sus vencimientos. Ya lo hicimos con gimnasios que venían de otro software y migraron cientos de socios sin cargar uno por uno.',
  },
  {
    q: '¿Funciona sin internet?',
    a: 'Sí. El mostrador sigue trabajando con el cable desenchufado: cobrás, das de alta un socio, registrás entradas y salidas, anotás gastos y cerrás la caja. Todo queda guardado en la computadora del gimnasio y sube solo cuando vuelve la conexión, con la hora en que pasó de verdad. Lo único que no se puede hacer sin internet es ver los datos desde afuera, porque para eso sí hace falta la nube.',
  },
  {
    q: '¿Y si tengo más de una sucursal?',
    a: 'Cada sucursal es independiente: su caja, sus socios y su equipo. Como dueño tenés una pantalla de resumen que te muestra todas juntas. Se paga por sucursal.',
  },
  {
    q: '¿Cómo cobro las cuotas de mis socios?',
    a: 'Como quieras: efectivo, transferencia o Mercado Pago. Vos registrás el cobro en Veltronik y el sistema corre el vencimiento del socio automáticamente. Veltronik no se queda con una comisión de lo que cobrás.',
  },
  {
    q: '¿Qué pasa con mis datos si me voy?',
    a: 'Son tuyos. Los bajás a Excel cuando quieras, antes o después de irte: socios, cobros y caja. No hay permanencia ni multa por irte.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Veltronik',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, Windows',
      description: 'Sistema para gimnasios: socios, cuotas, caja diaria, asistencia por QR, tablero del dueño y Excel para el contador. Funciona sin internet.',
      url: SITE_URL,
      inLanguage: 'es-AR',
      offers: planes.map((p) => ({
        '@type': 'Offer',
        name: p.name,
        price: String(p.price),
        priceCurrency: 'ARS',
        category: 'Suscripción mensual por sucursal',
        url: `${SITE_URL}/#precios`,
      })),
    },
    {
      '@type': 'Organization',
      name: 'Veltronik',
      url: SITE_URL,
      logo: `${SITE_URL}/logo.png`,
      email: CONTACTO.email,
      areaServed: 'AR',
      address: { '@type': 'PostalAddress', addressLocality: 'Posadas', addressRegion: 'Misiones', addressCountry: 'AR' },
      // sameAs le dice a Google que el canal es de esta misma organización.
      sameAs: [REDES.youtube],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Base
  title="Software para gimnasios en Argentina | Veltronik"
  description="Sistema para gimnasios: socios, cuotas, caja y asistencia en un solo lugar. Cobrás en dos clicks, ves cuánto entró desde el celular y funciona sin internet. 14 días gratis, sin tarjeta."
  schema={schema}
>
  {/* ─── HERO: qué es arriba, y el sistema de verdad abajo ─── */}
  <section class="hero">
    <div class="wrap">
      <div class="hero-texto center">
        <h1>
          <span class="hero-kicker">Sistema para gimnasios</span>
          Tu gimnasio entero, <span class="marcado">en un solo sistema.</span>
        </h1>
        <p class="lead">
          Socios, cuotas, caja y asistencia en una sola pantalla. Cobrás en dos clicks y
          sigue andando aunque se corte internet.
        </p>
        <div class="botones">
          <a class="btn btn-primario btn-grande" href={appRoute('/register')} data-primer-cta>
            Probar 14 días gratis <Icon name="flecha" size={18} />
          </a>
          {wa && (
            <a class="btn btn-wa btn-grande" href={waLink('Hola! Vi Veltronik en la web. ¿Me lo mostrás andando?')}>
              <Icon name="wa" size={18} /> Hablemos
            </a>
          )}
        </div>
        <ul class="garantias">
          <li>Sin tarjeta</li>
          <li>Socios ilimitados</li>
          <li>Sin permanencia</li>
        </ul>
        <p class="hero-origen"><Icon name="pin" size={16} /> Hecho en {CIUDAD}</p>
      </div>

      <div class="hero-pantallas">
        <Captura
          src={tablero}
          class="hero-escritorio"
          alt="El tablero de Veltronik: socios al día, ingresos del mes, socios vencidos, los que vencen esta semana y los ingresos de cada mes"
          anchos={[800, 1200, 1600, 2400]}
          sizes="(min-width: 1220px) 1060px, 88vw"
          prioridad
        />
        <Captura
          src={tableroCelular}
          tipo="celular"
          class="hero-celular"
          alt="El mismo tablero en el celular del dueño"
          anchos={[240, 360, 520, 780]}
          sizes="(min-width: 1000px) 250px, 30vw"
          prioridad
        />
      </div>
      <p class="hero-nota">Pantallas del sistema de verdad, con un gimnasio de ejemplo cargado.</p>
    </div>
  </section>

  {/* ─── LOS HECHOS: cuatro números, sin adornos ─── */}
  <section class="hechos-sec">
    <div class="wrap">
      <ul class="hechos">
        {hechos.map((h) => (
          <li>
            <p class="hecho-n num">{h.n} <span>{h.u}</span></p>
            <p class="hecho-t">{h.t}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── EL SISTEMA POR DENTRO ─── */}
  <section id="el-sistema" class="alt">
    <div class="wrap">
      <div class="cabecera center">
        <p class="rotulo">El sistema por dentro</p>
        <h2>Lo que vas a usar <span class="marcado">todos los días</span></h2>
        <p class="lead">
          Socios, cobros, caja y avisos en el mismo lugar. Lo que ves acá es lo mismo que vas a
          tener vos el día que lo pruebes.
        </p>
      </div>

      <div class="pantallas">
        {pantallas.map((p, i) => (
          <article class:list={['pantalla', { 'es-invertida': i % 2 === 1, 'es-de-celular': p.tipo === 'celular' }]}>
            <div class="pantalla-texto">
              <p class:list={['rotulo', p.clase]}>{p.rotulo}</p>
              <h3>{p.titulo}</h3>
              <p class="pantalla-bajada">{p.texto}</p>
              <ul class="pantalla-lista">
                {p.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
            <Captura
              src={p.img}
              alt={p.alt}
              tipo={p.tipo}
              class="pantalla-imagen"
              anchos={p.tipo === 'celular' ? [260, 390, 520, 780] : [600, 900, 1200, 1800]}
              sizes={p.tipo === 'celular' ? '(min-width: 900px) 300px, 70vw' : '(min-width: 1220px) 640px, (min-width: 900px) 55vw, 92vw'}
            />
          </article>
        ))}
      </div>

      <div class="mas-pantallas">
        {masPantallas.map((p) => (
          <article>
            <Captura src={p.img} alt={p.alt} anchos={[400, 700, 1000, 1500]} sizes="(min-width: 900px) 360px, 92vw" />
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ─── UN DÍA EN EL GIMNASIO ─── */}
  <section id="un-dia">
    <div class="wrap">
      <div class="cabecera">
        <p class="rotulo">Cómo funciona</p>
        <h2>Un día en tu gimnasio, <span class="marcado">de punta a punta</span></h2>
        <p class="lead">
          No es un módulo suelto: es lo que pasa desde que abrís la persiana hasta que te
          vas a dormir sabiendo cuánto entró.
        </p>
      </div>

      <ol class="dia">
        {dia.map((d) => (
          <li class={d.alerta ? `dia-hora es-alerta ${d.alerta}` : 'dia-hora'}>
            <p class="dia-reloj num">{d.hora}</p>
            <span class="dia-punto" aria-hidden="true"><Icon name={d.icono} size={18} /></span>
            <div class="dia-texto">
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </div>
            <span class={`dia-chip ${d.chip.clase}`}>{d.chip.texto}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ─── CADA UNO, LO SUYO ─── */}
  <section class="alt">
    <div class="wrap">
      <div class="cabecera center">
        <p class="rotulo es-verde">Para quién es</p>
        <h2>Cuatro personas que dejan de renegar</h2>
      </div>
      <div class="roles">
        {roles.map((r) => (
          <article class="rol">
            <div class="rol-cabeza">
              <span class="rol-icono"><Icon name={r.icono} size={20} /></span>
              <h3>{r.quien}</h3>
            </div>
            <ul>
              {r.items.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ─── CAMBIAR DA MIEDO ─── */}
  <section>
    <div class="wrap">
      <div class="cabecera">
        <p class="rotulo es-ambar">Sin riesgo</p>
        <h2>Cambiar de sistema da miedo. <span class="marcado">Por eso:</span></h2>
      </div>
      <div class="columnas">
        {confianza.map((c) => (
          <article>
            <span class="columnas-icono"><Icon name={c.icono} size={22} /></span>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ─── PRECIOS ─── */}
  <section id="precios" class="alt">
    <div class="wrap">
      <div class="cabecera center">
        <p class="rotulo es-verde">Precios</p>
        <h2>Un precio. Todos tus socios.</h2>
        <p class="lead">Sin comisión por cobro, sin costo por socio y sin permanencia. Si te querés ir, te vas.</p>
      </div>

      {/*
        Los planes salen del catálogo real (`/public/plans`): si mañana nace un tercero,
        aparece solo. Hasta el 2026-09-16 acá se dibujaba solo `planes[0]` y el plan con
        control de acceso era invisible en la web mientras estaba prendido en el backend.
      */}
      <div class="precios">
        {planes.map((p, i) => (
          <article class={`precio ${i === 0 ? 'es-principal' : ''}`}>
            <p class="precio-para">{i === 0 ? 'Para todo el gimnasio' : 'Con la puerta que cobra sola'}</p>
            <h3>{p.name}</h3>
            <p class="precio-tagline">{p.tagline}</p>
            <p class="precio-monto num">
              <span class="signo">$</span><span class="n">{formatoPrecio(p.price)}</span><span class="per">/ mes</span>
            </p>
            <p class="precio-sub">Por sucursal, en pesos argentinos. IVA incluido.</p>

            {/*
              El básico se contrata solo; el premium NO, y no es un descuido. El control de
              acceso necesita un molinete o una puerta, que se cotiza según el equipo que ya
              tenga el gimnasio. Ofrecer "14 días gratis" en ese plan sería venderle a alguien
              una función que no va a poder usar hasta que le llegue el hardware.
            */}
            {i === 0 ? (
              <Fragment>
                <a class="btn btn-primario btn-grande" href={appRoute('/register')}>Empezar los 14 días gratis</a>
                <p class="precio-letra">No pedimos tarjeta para la prueba.</p>
              </Fragment>
            ) : (
              <Fragment>
                <a
                  class="btn btn-wa btn-grande"
                  href={waLink(`Hola! Me interesa el plan ${p.name} con control de acceso. ¿Me pasás info?`) || `mailto:${CONTACTO.email}?subject=Consulta%20por%20el%20plan%20con%20control%20de%20acceso`}
                ><Icon name="wa" size={18} /> Hablemos por WhatsApp</a>
                <p class="precio-letra">El molinete se cotiza aparte, según tu entrada. Seguís en el plan Veltronik hasta que el molinete esté funcionando.</p>
              </Fragment>
            )}

            <ul class="precio-lista">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ─── PREGUNTAS ─── */}
  <section>
    <div class="wrap">
      <div class="cabecera center">
        <p class="rotulo">Preguntas</p>
        <h2>Lo que nos preguntan siempre</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─── EL CIERRE ─── */}
  <section class="cierre">
    <div class="wrap">
      <div class="cierre-caja">
        <Marca size={520} id="marca-cierre" class="cierre-marca" />
        <h2>Probalo con los socios <span class="marcado">que ya tenés.</span></h2>
        <p class="lead">
          Creás la cuenta, cargás tu gimnasio y esa misma tarde estás cobrando desde
          Veltronik. O escribinos y te lo dejamos andando con tu Excel adentro.
        </p>
        <div class="botones">
          <a class="btn btn-primario btn-grande" href={appRoute('/register')}>Probar 14 días gratis <Icon name="flecha" size={18} /></a>
          {wa && (
            <a class="btn btn-wa btn-grande" href={waLink('Hola! Quiero probar Veltronik con mis socios. ¿Me ayudás a cargarlos?')}>
              <Icon name="wa" size={18} /> Te ayudamos a arrancar
            </a>
          )}
        </div>
        <ul class="garantias">
          <li>14 días gratis</li>
          <li>Sin tarjeta</li>
          <li>Sin permanencia</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-texto { max-width: 880px; margin-inline: auto; }
