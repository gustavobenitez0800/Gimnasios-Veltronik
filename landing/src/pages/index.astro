  .hero-pantallas {
    position: relative; max-width: 1060px; margin: clamp(2.8rem, 6vw, 4.5rem) auto 0;
    padding-right: clamp(28px, 9vw, 120px);
  }
  .hero-pantallas::before {
    /* El brillo detrás: un degradé radial y nada más (con `filter: blur` Chromium rompía el
       dibujo al scrollear; ver la historia de esta página). */
    content: ''; position: absolute; inset: -12% -6% 10%; z-index: -1;
    background: radial-gradient(closest-side, rgba(59,130,246,.22), rgba(59,130,246,.05) 60%, transparent);
  }
  /* :global porque la clase va al <figure> de Captura, que es otro componente. */
  .hero-pantallas :global(.hero-escritorio) {
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }
  .hero-pantallas :global(.hero-celular) {
    position: absolute; right: 0; bottom: -4%;
