    /* Invertida: el texto pasa a la derecha y los anchos se dan vuelta con él, para que la
       captura siga en la columna ancha. */
    .pantalla.es-invertida { grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); }
    .pantalla.es-invertida .pantalla-texto { order: 2; }
    /* El celular es angosto: la columna de la imagen se achica y el texto respira. */
    .pantalla.es-de-celular { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); }
