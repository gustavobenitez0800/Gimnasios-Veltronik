# ============================================
# VELTRONIK V2 — .gitignore raíz
# ============================================

# Dependencias (nunca se versionan)
node_modules/

# Compilados sueltos de Java fuera de target/
*.class

# Artefactos de build de escritorio (Electron)
release/
release-builds/

# Secretos — NUNCA subir credenciales al repositorio
.env
.env.*
!.env.example

# Scripts operativos ad-hoc con credenciales (regla 8 de docs/ARCHITECTURE.md):
# NUNCA se commitean.
scripts/

# Sistema operativo / editores
.DS_Store
Thumbs.db
*.swp

# Tooling local (preview server, etc.)
.claude/

# El arranque del entorno de prueba local: levanta el Postgres 16 embebido (zonky) en el
# puerto 5544 y se queda colgado para que los datos vivan mientras dure la sesión. Es un
# andamio de la máquina de quien prueba, no del proyecto — y ya se coló en tres commits
# porque figuraba como archivo sin trackear. Cómo se rehace: la nota del entorno local.
backend/src/test/java/com/veltronik/v2/support/LocalStackDb.java
